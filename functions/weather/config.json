          "line_end": 33,
          "code": "class WeatherResult:\n    city: str\n    country: str\n    temperature: float\n    windspeed: float\n    weather_code: int\n    description: str\n    error: str = \"\"\n\n    def to_dict(self) -> dict:\n        return self.__dict__\n\n\n# WMO weather code → human description",

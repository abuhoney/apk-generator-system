          "code": "class QRResult:\n    text: str\n    svg: str\n    size: int\n\n    def to_dict(self) -> dict:\n        return {\"text\": self.text, \"svg\": self.svg, \"size\": self.size}\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": [
            "to_dict"
          ]
        },
        {
          "id": "to_dict",
          "kind": "function",
          "line_start": 21,
          "line_end": 24,
          "code": "    def to_dict(self) -> dict:\n        return {\"text\": self.text, \"svg\": self.svg, \"size\": self.size}\n\n",
          "file": "handler.py",
          "branch_of": "QRResult",
          "children": []
        },
        {
          "id": "_qr_svg_via_api",
          "kind": "function",
          "line_start": 25,
          "line_end": 34,
          "code": "def _qr_svg_via_api(text: str, size: int = 256) -> str:\n    \"\"\"Use the public QuickChart API to render a QR as SVG.\n    This works offline-bundled by the WebView; if the API is unreachable\n    the front-end falls back to its own encoder.\"\"\"\n    enc = urllib.parse.quote(text, safe=\"\")\n    return f'<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{size}\" height=\"{size}\" viewBox=\"0 0 {size} {size}\">' \\\n           f'<image href=\"https://quickchart.io/qr?text={enc}&size={size}\" width=\"{size}\" height=\"{size}\"/>' \\\n           f'</svg>'\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": []
        },
        {
          "id": "generate_qr",
          "kind": "function",
          "line_start": 35,
          "line_end": 41,
          "code": "def generate_qr(text: str, size: int = 256) -> QRResult:\n    if not text:\n        text = \" \"\n    svg = _qr_svg_via_api(text, size)\n    return QRResult(text=text, svg=svg, size=size)\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": []
        },
        {
          "id": "generate_qr_data_url",
          "kind": "function",
          "line_start": 42,
          "line_end": 48,
          "code": "def generate_qr_data_url(text: str, size: int = 256) -> str:\n    \"\"\"Return a data: URL the front-end can drop straight into <img src>.\"\"\"\n    res = generate_qr(text, size)\n    b64 = base64.b64encode(res.svg.encode(\"utf-8\")).decode(\"ascii\")\n    return f\"data:image/svg+xml;base64,{b64}\"\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": []
        }
      ]

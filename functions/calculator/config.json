        {
          "id": "_safe_eval",
          "kind": "function",
          "line_start": 35,
          "line_end": 52,
          "code": "def _safe_eval(node: ast.AST) -> float:\n    if isinstance(node, ast.Constant):\n        if isinstance(node.value, (int, float)):\n            return node.value\n        raise ValueError(f\"unsupported constant: {node.value!r}\")\n    if isinstance(node, ast.BinOp):\n        op = _OPS.get(type(node.op))\n        if op is None:\n            raise ValueError(f\"unsupported operator: {type(node.op).__name__}\")\n        return op(_safe_eval(node.left), _safe_eval(node.right))\n    if isinstance(node, ast.UnaryOp):\n        op = _OPS.get(type(node.op))\n        if op is None:\n            raise ValueError(f\"unsupported unary op: {type(node.op).__name__}\")\n        return op(_safe_eval(node.operand))\n    raise ValueError(f\"unsupported expression: {type(node).__name__}\")\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": []
        },
        {
          "id": "calculate",
          "kind": "function",
          "line_start": 53,
          "line_end": 62,
          "code": "def calculate(expression: str) -> CalcResult:\n    \"\"\"Evaluate a mathematical expression safely.\"\"\"\n    try:\n        tree = ast.parse(expression.strip(), mode=\"eval\")\n        result = _safe_eval(tree.body)\n        return CalcResult(expression=expression, result=float(result))\n    except Exception as e:\n        return CalcResult(expression=expression, result=0.0, error=str(e))\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": []
        },
        {
          "id": "record",
          "kind": "function",
          "line_start": 66,
          "line_end": 71,
          "code": "def record(result: CalcResult) -> None:\n    _history.append(result)\n    if len(_history) > 100:\n        _history.pop(0)\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": []
        },
        {
          "id": "history",
          "kind": "function",
          "line_start": 72,
          "line_end": 75,
          "code": "def history() -> list[dict]:\n    return [r.to_dict() for r in reversed(_history)]\n\n",
          "file": "handler.py",

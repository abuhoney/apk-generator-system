        },
        {
          "id": "add_todo",
          "kind": "function",
          "line_start": 27,
          "line_end": 34,
          "code": "def add_todo(text: str) -> Todo:\n    now = datetime.datetime.utcnow().isoformat(timespec=\"seconds\") + \"Z\"\n    t = Todo(id=str(uuid.uuid4()), text=text, done=False,\n             created_at=now, completed_at=None)\n    _store.append(t)\n    return t\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": []
        },
        {
          "id": "list_todos",
          "kind": "function",
          "line_start": 35,
          "line_end": 39,
          "code": "def list_todos(include_done: bool = True) -> list[dict]:\n    items = _store if include_done else [t for t in _store if not t.done]\n    return [t.to_dict() for t in items]\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": []
        },
        {
          "id": "toggle_todo",
          "kind": "function",
          "line_start": 40,
          "line_end": 48,
          "code": "def toggle_todo(todo_id: str) -> Optional[Todo]:\n    for t in _store:\n        if t.id == todo_id:\n            t.done = not t.done\n            t.completed_at = (datetime.datetime.utcnow().isoformat(timespec=\"seconds\") + \"Z\") if t.done else None\n            return t\n    return None\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": []
        },
        {
          "id": "delete_todo",
          "kind": "function",
          "line_start": 49,
          "line_end": 55,
          "code": "def delete_todo(todo_id: str) -> bool:\n    global _store\n    before = len(_store)\n    _store = [t for t in _store if t.id != todo_id]\n    return len(_store) < before\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": []
        },
        {
          "id": "clear_done",
          "kind": "function",
          "line_start": 56,
          "line_end": 62,
          "code": "def clear_done() -> int:\n    global _store\n    before = len(_store)\n    _store = [t for t in _store if not t.done]\n    return before - len(_store)\n\n",
          "file": "handler.py",
          "branch_of": null,

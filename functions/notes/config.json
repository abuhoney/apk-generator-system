          "id": "create_note",
          "kind": "function",
          "line_start": 31,
          "line_end": 43,
          "code": "def create_note(title: str, body: str = \"\") -> Note:\n    now = datetime.datetime.utcnow().isoformat(timespec=\"seconds\") + \"Z\"\n    note = Note(\n        id=str(uuid.uuid4()),\n        title=title or \"Untitled\",\n        body=body,\n        created_at=now,\n        updated_at=now,\n    )\n    _store[note.id] = note\n    return note\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": []
        },
        {
          "id": "get_note",
          "kind": "function",
          "line_start": 44,
          "line_end": 47,
          "code": "def get_note(note_id: str) -> Optional[Note]:\n    return _store.get(note_id)\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": []
        },
        {
          "id": "list_notes",
          "kind": "function",
          "line_start": 48,
          "line_end": 52,
          "code": "def list_notes() -> list[dict]:\n    return [n.to_dict() for n in sorted(_store.values(),\n                                         key=lambda n: n.updated_at, reverse=True)]\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": []
        },
        {
          "id": "update_note",
          "kind": "function",
          "line_start": 53,
          "line_end": 65,
          "code": "def update_note(note_id: str, title: Optional[str] = None,\n                body: Optional[str] = None) -> Optional[Note]:\n    note = _store.get(note_id)\n    if note is None:\n        return None\n    if title is not None:\n        note.title = title\n    if body is not None:\n        note.body = body\n    note.updated_at = datetime.datetime.utcnow().isoformat(timespec=\"seconds\") + \"Z\"\n    return note\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": []
        },
        {
          "id": "delete_note",
          "kind": "function",
          "line_start": 66,
          "line_end": 69,
          "code": "def delete_note(note_id: str) -> bool:\n    return _store.pop(note_id, None) is not None\n\n",
          "file": "handler.py",
          "branch_of": null,
          "children": []
        },
        {
          "id": "search_notes",
          "kind": "function",
          "line_start": 70,
          "line_end": 75,
          "code": "def search_notes(query: str) -> list[dict]:\n    q = query.lower()\n    return [n.to_dict() for n in _store.values()\n            if q in n.title.lower() or q in n.body.lower()]\n\n",
